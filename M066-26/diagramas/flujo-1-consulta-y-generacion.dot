digraph M066 {
 graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.25", ranksep="0.25", fontname="Arial", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#F5F5F5", color="#737373", fontname="Arial", fontsize=11, margin="0.12,0.07"];
 edge [fontname="Arial", fontsize=10, color="#555555", arrowsize=0.65];
 inicio [label="Seleccionar débito y destino\nIngresar moneda e importe válido", fillcolor="#FCE8E8",color="#C00000"];
 cambio [shape=diamond,label="¿Monedas\ndiferentes?",style=filled];
 existente [shape=diamond,label="¿Selecciona una\nboleta existente?",style=filled];
 elegible [shape=diamond,label="¿Elegible y dentro\ndel horario?",style=filled];
 consultar [label="Consultar mejora de cotización"];
 oferta [shape=diamond,label="¿Hay oferta y el\ncliente la elige?",style=filled];
 generar [label="GENERAR BOLETA\nConcertar monto y cotización"];
 generada [shape=diamond,label="¿Generación\nconfirmada?",style=filled];
 seleccionar [label="Consultar y seleccionar\nboleta compatible"];
 pizarra [label="Continuar flujo habitual\nPizarra si hay cambio · Sin nueva boleta",fillcolor="#FFF4E5"];
 revisar [label="Informar / corregir / reintentar\nNo avanzar con mejora inválida",fillcolor="#FFF4E5"];
 inicio -> cambio;
 cambio -> existente [label="Sí"];

 existente -> seleccionar [label="Sí"];
 existente -> elegible [label="No"];
 elegible -> consultar [label="Sí"];
 elegible -> pizarra [label="No"];
 consultar -> oferta;
 oferta -> generar [label="Sí"];
 oferta -> pizarra [label="No"];
 generar -> generada;
 generada -> revisar [label="No"];
 paso [label="A · Continuar en validación
y preconfirmación",shape=ellipse,fillcolor="#FCE8E8",color="#C00000"];
 cambio -> pizarra [label="No"];
 pizarra -> paso;
 seleccionar -> paso;
 generada -> paso [label="Sí"];
}